
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /businessActors/{actorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      // Mengizinkan user mendaftarkan dirinya sendiri sebagai admin (untuk setup awal/Agus)
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    match /system_users/{uid} {
      allow read: if isSignedIn();
      // Mengizinkan user mendaftarkan/mengupdate data profilnya sendiri
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
  }
}
