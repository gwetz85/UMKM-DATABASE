
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || 
        request.auth.token.email == "agus@umkm.id"
      );
    }

    match /businessActors/{actorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == adminId && request.auth.token.email == "agus@umkm.id");
      allow delete: if isAdmin();
    }

    match /system_users/{username} {
      allow read: if isSignedIn();
      
      // Izinkan publik mendaftar (create), tapi role harus "pending"
      allow create: if isAdmin() || (
        request.resource.data.role == "pending" && 
        request.resource.data.uid == null
      );
      
      allow delete: if isAdmin();
      
      allow update: if isAdmin() || (
        isSignedIn() && (
          (resource.data.uid == null && request.resource.data.uid == request.auth.uid) ||
          (resource.data.uid == request.auth.uid)
        )
      );
    }

    match /master_data/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
