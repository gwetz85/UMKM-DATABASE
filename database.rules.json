{
  "rules": {
    "roles_admin": {
      ".read": "auth != null",
      "$adminId": {
        ".write": "(auth != null && auth.uid == $adminId && auth.token.email == 'agus@umkm.id') || (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')"
      }
    },
    "businessActors": {
      ".read": "true",
      ".indexOn": ["ownerId", "status", "createdAt", "coordinator", "nik", "noKK", "phone", "petugasSurvey", "verifikatorDinas", "hasilVerifikasiDinas"],
      "$actorId": {
         ".write": "auth != null && (newData.exists() || root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')"
      }
    },
    "survey_photos": {
      ".read": "true",
      "$actorId": {
        ".write": "auth != null"
      }
    },
    "system_users": {
      ".read": "true",
      ".indexOn": ["uid", "role", "fullName"],
      "$username": {
        ".write": "auth != null || newData.child('role').val() == 'pending' || $username == 'monitoring'"
      }
    },
    "chat_messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["chatId", "timestamp", "senderId"]
    },
    "master_data": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".indexOn": ["nik", "kk", "noKK", "nama", "koperasi"]
    },
    "master_data_2023": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".indexOn": ["nik", "kk", "noKK", "nama", "koperasi"]
    },
    "master_data_2024": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".indexOn": ["nik", "kk", "noKK", "nama", "koperasi"]
    },
    "master_data_2025": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".indexOn": ["nik", "kk", "noKK", "nama", "koperasi"]
    },
    "blacklist_data": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".indexOn": ["nik", "kk", "noKK", "nama", "koperasi"]
    },
    "users": {
       "$uid": {
          "businessActors": {
             ".read": "auth != null && auth.uid == $uid",
             ".write": "auth != null && auth.uid == $uid",
             ".indexOn": ["createdAt"]
          }
       }
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "true",
      ".write": "auth != null"
    },
    "koordinator_kuotas": {
      ".read": "true",
      ".write": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')"
    },
    "activity_logs": {
      ".read": "auth != null && (root.child('roles_admin').child(auth.uid).exists() || auth.token.email == 'agus@umkm.id')",
      ".write": "true",
      ".indexOn": ["timestamp"]
    },
    "system_stats": {
      ".read": "true",
      ".write": "auth != null"
    }
  }
}
