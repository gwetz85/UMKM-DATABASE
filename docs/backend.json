
{
  "entities": {
    "BusinessActor": {
      "title": "BusinessActor",
      "type": "object",
      "description": "Data pelaku usaha lengkap dengan status verifikasi dan informasi rekening.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "nik": { "type": "string" },
        "noKK": { "type": "string" },
        "pobDob": { "type": "string", "description": "Tempat / Tanggal Lahir" },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "rtRw": { "type": "string" },
        "kelurahan": { "type": "string" },
        "businessCategory": { "type": "string", "enum": ["Kuliner", "Bukan Kuliner"] },
        "businessName": { "type": "string" },
        "businessLocation": { "type": "string" },
        "bankNumber": { "type": "string" },
        "bankOwner": { "type": "string" },
        "bankName": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "verified_actor", "bank_pending", "finish"],
          "description": "Status alur verifikasi data"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["fullName", "nik", "noKK", "status"]
    },
    "SystemUser": {
      "title": "SystemUser",
      "type": "object",
      "description": "Data pengguna sistem (Admin atau Petugas).",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "petugas"] },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/businessActors/{actorId}",
        "definition": {
          "entityName": "BusinessActor",
          "schema": { "$ref": "#/backend/entities/BusinessActor" },
          "description": "Koleksi utama data pelaku usaha (Top-level untuk akses Admin)"
        }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": {
          "entityName": "RoleAdmin",
          "description": "Menandai user sebagai Admin"
        }
      },
      {
        "path": "/system_users/{uid}",
        "definition": {
          "entityName": "SystemUser",
          "schema": { "$ref": "#/backend/entities/SystemUser" },
          "description": "Daftar pengguna yang diizinkan masuk ke sistem"
        }
      }
    ]
  }
}
