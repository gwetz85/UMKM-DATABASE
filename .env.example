# ==========================================
# SIMPU - Environment Variables Template
# Salin berkas ini ke .env atau .env.local lalu isi nilainya.
# JANGAN PERNAH menyertakan atau commit .env / .env.local ke repositori git!
# ==========================================

# Google Gemini / GenAI Configuration
# Digunakan untuk fitur AI Genkit (Analisis & Panduan Kepatuhan Usaha)
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_API_KEY=

# Telegram Bot Integration
# Digunakan untuk notifikasi dan webhook Telegram Bot SIMPU
TELEGRAM_BOT_TOKEN=

# Email / SMTP Configuration
# Digunakan untuk pengiriman pesan formulir offline via Nodemailer
EMAIL_USER=
EMAIL_PASS=

# CRON Security Secret
# Token keamanan untuk otorisasi endpoint cron job (auto-verify, sync-stats)
CRON_SECRET=
